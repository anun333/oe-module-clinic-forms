{
  "id": "records-request",
  "title": "Request for Records",
  "category": "Care coordination",
  "about": "A request to another provider for a patient's records, with the patient's signature.",
  "audience": "provider",
  "version": 2,
  "status": "active",
  "source": {
    "kind": "written",
    "name": "Written for Clinic Forms"
  },
  "licence": {
    "holder": "Clinic Forms contributors",
    "terms": "GPL-3.0-or-later, as the module. Adapt it for your clinic."
  },
  "blocks": [
    {
      "type": "fields",
      "fields": [
        {
          "label": "Date",
          "value": "{clinic.today}"
        },
        {
          "label": "To",
          "value": "{recipient.organization}"
        },
        {
          "label": "Attention",
          "value": "{recipient.name}"
        },
        {
          "label": "Fax",
          "value": "{recipient.fax}"
        },
        {
          "label": "Phone",
          "value": "{recipient.phone}"
        }
      ]
    },
    {
      "type": "paragraph",
      "text": "{facility.name} is now caring for the patient below. Please send the records ticked below to us at fax {facility.fax}, or to {facility.address}."
    },
    {
      "type": "fields",
      "fields": [
        {
          "label": "Patient name",
          "value": "{patient.name}"
        },
        {
          "label": "Date of birth",
          "value": "{patient.dob}"
        },
        {
          "label": "Patient ID",
          "value": "{patient.id}"
        }
      ]
    },
    {
      "type": "checklist",
      "items": [
        "Last two years of visit notes",
        "Problem and medication lists",
        "Immunization record",
        "Laboratory results",
        "Imaging reports",
        "Specialist reports",
        "Other (write below)"
      ]
    },
    {
      "type": "lines",
      "label": "Other",
      "count": 1
    },
    {
      "type": "fields",
      "fields": [
        {
          "label": "Requested by (name and phone)",
          "value": "{user.name}"
        }
      ]
    },
    {
      "type": "paragraph",
      "text": "The patient agrees to this request (signature below). If the law requires a signed authorization for these records, it is attached."
    },
    {
      "type": "signature",
      "signers": [
        "Patient or legal representative"
      ]
    },
    {
      "type": "fields",
      "fields": [
        {
          "label": "If signed by a representative: name"
        },
        {
          "label": "Relationship or legal authority"
        }
      ]
    }
  ]
}
