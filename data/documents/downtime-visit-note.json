    },
    {
      "type": "lines",
      "label": "History and examination",
      "count": 6
    },
    {
      "type": "lines",
      "label": "Assessment and diagnoses",
      "count": 3
    },
    {
      "type": "lines",
      "label": "Plan",
      "count": 4
    },
    {
      "type": "lines",
      "label": "Medications given or prescribed (name, dose, route, time)",
