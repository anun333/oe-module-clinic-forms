        {
          "label": "Date and time"
        },
        {
          "label": "Provider"
        },
        {
          "label": "Visit type"
        },
        {
          "label": "Allergies (asked today)"
        }
      ]
    },
    {
      "type": "fields",
      "fields": [
        {
          "label": "Blood pressure"
        },
        {
          "label": "Pulse"
        },
        {
          "label": "Temperature"
        },
        {
          "label": "Respirations"
