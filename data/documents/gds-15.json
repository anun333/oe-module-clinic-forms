{
    "id": "gds-15",
    "title": "Geriatric Depression Scale, Short Form (GDS-15)",
    "category": "Screening",
    "about": "Fifteen yes or no questions about mood over the past week, for older adults, scored 0 to 15.",
    "audience": "patient",
    "code": {
        "system": "http://loinc.org",
        "code": "48543-3",
        "display": "Geriatric depression scale (GDS).short version panel"
    },
    "validated": true,
