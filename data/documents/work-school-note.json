{
  "id": "work-school-note",
  "title": "Work or School Note",
  "category": "After the visit",
  "about": "Confirms a visit and when the patient may return, without saying why they were seen.",
  "audience": "patient",
  "version": 2,
  "status": "active",
  "source": {
    "kind": "written",
    "name": "Written for Clinic Forms"
  },
  "licence": {
    "holder": "Clinic Forms contributors",
    "terms": "GPL-3.0-or-later, as the module. Adapt it for your clinic."
  },
  "blocks": [
    {
      "type": "fields",
      "fields": [
        {
          "label": "Date",
          "value": "{clinic.today}"
        },
        {
          "label": "Patient name",
          "value": "{patient.name}"
        },
        {
          "label": "Date of birth",
          "value": "{patient.dob}"
        },
        {
          "label": "Date of visit"
        }
      ]
    },
    {
      "type": "paragraph",
      "text": "The patient named above was seen at {facility.name}. To protect their privacy, this note doesn't give the reason for the visit."
    },
    {
      "type": "checklist",
      "items": [
        "May return to work or school on the date below",
        "May return with the restrictions below",
        "Should stay home until seen again",
        "Came with the patient, as a parent or caregiver (name below)"
      ]
    },
    {
      "type": "fields",
      "fields": [
        {
          "label": "May return on"
        },
        {
          "label": "Excused from (date)"
        },
        {
          "label": "Excused to (date)"
        },
        {
          "label": "Parent or caregiver who came"
        }
      ]
    },
    {
      "type": "lines",
      "label": "Restrictions or notes",
      "count": 3
    },
    {
      "type": "signature",
      "signers": [
        "Clinician"
      ]
    },
    {
      "type": "fields",
      "fields": [
        {
          "label": "Clinician name (printed)",
          "value": "{provider.name}"
        },
        {
          "label": "Credentials",
          "value": "{provider.credentials}"
        },
        {
          "label": "Clinic phone",
          "value": "{facility.phone}"
        }
      ]
    }
  ]
}
