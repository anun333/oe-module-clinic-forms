{
  "id": "referral-letter",
  "title": "Referral Letter",
  "category": "Care coordination",
  "about": "A referral letter to a provider or organization in the Address Book.",
  "audience": "provider",
  "code": {
    "system": "http://loinc.org",
    "code": "57133-1",
    "display": "Referral Note"
  },
  "version": 2,
  "status": "active",
  "source": {
    "kind": "written",
    "name": "Written for Clinic Forms"
  },
  "licence": {
    "holder": "Clinic Forms contributors",
    "terms": "CC0 1.0: dedicated to the public domain. Use and adapt it freely, with no credit needed."
  },
  "blocks": [
    {
      "type": "fields",
      "fields": [
        {
          "label": "Date",
          "value": "{clinic.today}"
        },
        {
          "label": "To",
          "value": "{recipient.name}"
        },
        {
          "label": "Organization",
          "value": "{recipient.organization}"
        },
        {
          "label": "Specialty",
          "value": "{recipient.specialty}"
        },
        {
          "label": "Address",
          "value": "{recipient.address}"
        },
        {
          "label": "Phone",
          "value": "{recipient.phone}"
        },
        {
          "label": "Fax",
          "value": "{recipient.fax}"
        }
      ]
    },
    {
      "type": "heading",
      "text": "Patient"
    },
    {
      "type": "fields",
      "fields": [
        {
          "label": "Name",
          "value": "{patient.name}"
        },
        {
          "label": "Date of birth",
          "value": "{patient.dob}"
        },
        {
          "label": "Patient ID",
          "value": "{patient.id}"
        },
        {
          "label": "Phone",
          "value": "{patient.phone}"
        },
        {
          "label": "Address",
          "value": "{patient.address}"
        }
      ]
    },
    {
      "type": "heading",
      "text": "Referral"
    },
    {
      "type": "checklist",
      "label": "Urgency",
      "items": [
        "Routine",
        "Soon (within two weeks)",
        "Urgent (within two days; we will also call)"
      ]
    },
    {
      "type": "checklist",
      "label": "Requested",
      "items": [
        "Consultation and recommendations",
        "Consultation and treatment",
        "Evaluation for a procedure",
        "Other (write below)"
      ]
    },
    {
      "type": "lines",
      "label": "Reason for referral and question to answer",
      "count": 5
    },
    {
      "type": "fields",
      "fields": [
        {
          "label": "Problems",
          "value": "{patient.problems}"
        },
        {
          "label": "Medications",
          "value": "{patient.medications}"
        },
        {
          "label": "Allergies",
          "value": "{patient.allergies}"
        }
      ]
    },
    {
      "type": "lines",
      "label": "Other relevant history",
      "count": 2
    },
    {
      "type": "checklist",
      "label": "Enclosed",
      "items": [
        "Visit note",
        "Problem and medication lists",
        "Laboratory results",
        "Imaging reports",
        "Insurance information",
        "Authorization to release information"
      ]
    },
    {
      "type": "paragraph",
      "text": "Please send your report to {facility.name}, fax {facility.fax}, phone {facility.phone}."
    },
    {
      "type": "signature",
      "signers": [
        "Referring provider"
      ]
    },
    {
      "type": "fields",
      "fields": [
        {
          "label": "Name",
          "value": "{provider.name}"
        },
        {
          "label": "Credentials",
          "value": "{provider.credentials}"
        },
        {
          "label": "NPI",
          "value": "{provider.npi}"
        },
        {
          "label": "Specialty",
          "value": "{provider.specialty}"
        }
      ]
    }
  ]
}
