  "blocks": [
    {
      "type": "include",
      "block": "screening-header"
    },
    {
      "type": "paragraph",
      "text": "One drink is a can or bottle of beer, a glass of wine, or a single shot of spirits."
    },
    {
      "type": "checklist",
      "id": "how-often",
      "label": "1. How often do you have a drink containing alcohol?",
      "items": [
        "Never (0)",
        "Monthly or less (1)",
        "2 to 4 times a month (2)",
        "2 to 3 times a week (3)",
        "4 or more times a week (4)"
      ]
    },
    {
      "type": "paragraph",
      "text": "If you answered Never, stop here."
    },
    {
      "type": "checklist",
      "show_if": {
        "any": [
          {
            "id": "how-often",
            "answer": 2
          },
          {
            "id": "how-often",
            "answer": 3
          },
          {
            "id": "how-often",
            "answer": 4
          },
          {
            "id": "how-often",
            "answer": 5
          }
        ]
      },
      "label": "2. How many drinks containing alcohol do you have on a typical day when you are drinking?",
      "items": [
        "1 or 2 (0)",
        "3 or 4 (1)",
        "5 or 6 (2)",
        "7 to 9 (3)",
        "10 or more (4)"
      ]
    },
    {
      "type": "checklist",
      "show_if": {
        "any": [
          {
            "id": "how-often",
            "answer": 2
          },
          {
            "id": "how-often",
            "answer": 3
          },
          {
            "id": "how-often",
            "answer": 4
          },
          {
            "id": "how-often",
            "answer": 5
          }
        ]
      },
      "label": "3. How often do you have six or more drinks on one occasion?",
      "items": [
        "Never (0)",
        "Less than monthly (1)",
        "Monthly (2)",
        "Weekly (3)",
        "Daily or almost daily (4)"
      ]
    },
    {
      "type": "fields",
      "fields": [
        {
          "label": "Total score (for office use)"
        }
      ]
    },
    {
      "type": "heading",
      "text": "For office use"
    },
    {
      "type": "paragraph",
      "text": "Common cut-offs for a positive screen: 4 or more for men, 3 or more for women."
    },
    {
      "type": "include",
      "block": "office-review"
    },
    {
      "type": "paragraph",
      "text": "From the Alcohol Use Disorders Identification Test (AUDIT), World Health Organization."
    }
  ]
}
