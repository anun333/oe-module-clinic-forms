{
  "id": "audit-c",
  "title": "Alcohol Use Screen (AUDIT-C)",
  "category": "Screening",
  "about": "The first three questions of the World Health Organization's AUDIT, scored 0 to 12.",
  "audience": "patient",
  "code": {
    "system": "http://loinc.org",
    "code": "72109-2",
    "display": "Alcohol Use Disorder Identification Test - Consumption [AUDIT-C]"
  },
  "validated": true,
  "version": 2,
  "status": "active",
  "source": {
    "kind": "instrument",
    "name": "AUDIT-C, questions 1 to 3 of the WHO AUDIT",
