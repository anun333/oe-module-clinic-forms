{
  "id": "release-of-information",
  "title": "Authorization to Release Health Information",
  "category": "Front desk",
  "about": "A HIPAA authorization to disclose health information, with the elements 45 CFR 164.508 requires.",
  "audience": "patient",
  "code": {
    "system": "http://loinc.org",
    "code": "64292-6",
    "display": "Release of Information Consent Document"
  },
  "version": 2,
  "status": "active",
  "source": {
    "kind": "rule",
    "name": "HIPAA authorization, 45 CFR 164.508(c)",
    "url": "https://www.ecfr.gov/current/title-45/section-164.508"
  },
  "licence": {
    "holder": "Clinic Forms contributors",
    "terms": "CC0 1.0: dedicated to the public domain. Use and adapt it freely, with no credit needed."
  },
  "blocks": [
    {
      "type": "fields",
      "fields": [
        {
          "label": "Patient name",
          "value": "{patient.name}"
        },
        {
          "label": "Date of birth",
          "value": "{patient.dob}"
        },
        {
          "label": "Patient ID",
          "value": "{patient.id}"
        }
      ]
    },
    {
      "type": "heading",
      "text": "Who may release the information"
    },
    {
      "type": "fields",
      "fields": [
        {
          "label": "From",
          "value": "{facility.name}"
        },
        {
          "label": "Address",
          "value": "{facility.address}"
        },
        {
          "label": "Phone",
          "value": "{facility.phone}"
        },
        {
          "label": "Fax",
          "value": "{facility.fax}"
        }
      ]
    },
    {
      "type": "heading",
      "text": "Who may receive it"
    },
    {
      "type": "fields",
      "fields": [
        {
          "label": "Name or organization",
          "value": "{recipient.organization}"
        },
        {
          "label": "Person",
          "value": "{recipient.name}"
        },
        {
          "label": "Address",
          "value": "{recipient.address}"
        },
        {
          "label": "Phone",
          "value": "{recipient.phone}"
        },
        {
          "label": "Fax",
          "value": "{recipient.fax}"
        }
      ]
    },
    {
      "type": "heading",
      "text": "What may be released"
    },
    {
      "type": "checklist",
      "items": [
        "The entire record",
        "Records from these dates only (write below)",
        "Visit notes",
        "Problem and medication lists",
        "Laboratory results",
        "Imaging reports",
        "Immunization record",
        "Other (write below)"
      ]
    },
    {
      "type": "lines",
      "label": "Dates or other details",
      "count": 2
    },
    {
      "type": "paragraph",
      "text": "Some information needs your separate permission. Initial each one you allow."
    },
    {
      "type": "checklist",
      "items": [
        "____ HIV/AIDS testing or treatment",
        "____ Mental health treatment (not psychotherapy notes, which need a separate authorization)",
        "____ Substance use disorder treatment records (records from a federally assisted substance use disorder program, covered by 42 CFR Part 2, need our Part 2 consent form instead)",
        "____ Genetic testing",
        "____ Sexual and reproductive health"
      ]
    },
    {
      "type": "heading",
      "text": "Purpose"
    },
    {
      "type": "checklist",
      "items": [
        "At my request",
        "Continuing care",
        "Insurance or benefits",
        "Legal",
        "Other (write below)"
      ]
    },
    {
      "type": "lines",
      "label": "Other purpose",
      "count": 1
    },
    {
      "type": "heading",
      "text": "How long this authorization lasts"
    },
    {
      "type": "fields",
      "fields": [
        {
          "label": "It expires on this date or event"
        }
      ]
    },
    {
      "type": "heading",
      "text": "Your rights"
    },
    {
      "type": "paragraph",
      "text": "You may revoke (cancel) this authorization at any time by writing to {facility.name}. This does not undo anything already released because of it. The Notice of Privacy Practices explains how."
    },
    {
      "type": "paragraph",
      "text": "Signing is your choice. Your treatment, payment, enrollment or eligibility for benefits will not depend on whether you sign. The one exception is care given only to make information for someone else, such as an exam an employer or insurer asked for: we may need your signature before we give that care."
    },
    {
      "type": "paragraph",
      "text": "Information released under this authorization may be disclosed again by the person who receives it. It may then no longer be protected by federal privacy law. You will be given a copy of this authorization."
    },
    {
      "type": "signature",
      "signers": [
        "Patient or legal representative"
      ]
    },
    {
      "type": "fields",
      "fields": [
        {
          "label": "If signed by a representative: name"
        },
        {
          "label": "Relationship or legal authority"
        }
      ]
    }
  ]
}
