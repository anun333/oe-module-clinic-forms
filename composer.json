{
    "name": "anun333/oe-module-clinic-forms",
    "description": "Printable clinic paperwork for OpenEMR: consents, releases, referral letters and blank intake packets, filled with the clinic's own details, and paper versions of any layout form",
    "type": "openemr-module",
    "license": "GPL-3.0-or-later",
    "keywords": ["openemr", "openemr-module", "forms", "paperwork", "intake", "printing"],
    "authors": [{"name": "anun333", "email": "anun333@posteo.net"}],
    "require": {
        "php": ">=8.3",
        "openemr/oe-module-installer-plugin": "^0.1.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {"OpenHealthcare\\ClinicForms\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"OpenHealthcare\\ClinicForms\\Tests\\": "tests/"},
        "files": ["tests/stubs.php"]
    },
    "config": {
        "allow-plugins": {"openemr/oe-module-installer-plugin": true}
    },
    "support": {
        "issues": "https://github.com/anun333/oe-module-clinic-forms/issues",
        "source": "https://github.com/anun333/oe-module-clinic-forms"
    }
}
